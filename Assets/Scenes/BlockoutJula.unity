  m_Name: 
  m_EditorClassIdentifier: 
  CurrentIDCounter: 7
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":2}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":419,\"yPos\":326},\"ID\":1,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"
    Kuwety s\u0105 codziennie sprz\u0105tane, a wszystkie koty przebadane. Niczym
    si\u0119 nie zarazisz\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":6}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":521,\"yPos\":609},\"ID\":3,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"
    Nie roznsisz zarazk\xF3w. Nie masz si\u0119 czym martwi\u0107\",\"parentUIDs\":[2],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":5}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":293,\"yPos\":603},\"ID\":4,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tak,
    to ty jeste\u015B problemem.\_\",\"parentUIDs\":[2],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":1}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":412,\"yPos\":165},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Czy
    ta kuweta na pewno jest czysta? Kto\u015B tu si\u0119 za\u0142atwia\u0142 wcze\u015Bniej?
    Co je\u015Bli si\u0119 czym\u015B zara\u017C\u0119?\_\\nCzym mog\u0119 si\u0119
    zarazi\u0107? Jakie tu mog\u0105 by\u0107 wirusy i paso\u017Cyty?\_\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Maxwell\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":3},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":4}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":421,\"yPos\":456},\"ID\":2,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Na
    pewno? Ile godzin temu by\u0142y sprz\u0105tane te kuwety? Kiedy ostatnio koty
    mia\u0142y badania? Dlaczego ja nie mia\u0142em bada\u0144? Czy na pewno jestem
    zdrowy? Mo\u017Ce to ja roznosz\u0119 zarazki i nawet o tym nie wiem...\_\",\"parentUIDs\":[1],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Maxwell\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":288,\"yPos\":701},\"ID\":5,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Wybucha\\n\",\"parentUIDs\":[4],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Maxwell\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":529,\"yPos\":708},\"ID\":6,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Oo
    super. To si\u0119 nie martwi\u0119\",\"parentUIDs\":[3],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Maxwell\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
